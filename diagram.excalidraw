      "updated": 1783183198470,
      "link": null,
      "locked": false,
      "text": "Randomly select 2–3 letters.\nQuery MusicBrainz for each letter with a random offset.\nMerge the results into one candidate pool.\nRandomly sample 10–20 artists.\nSave only those artists into the landing layer.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Randomly select 2–3 letters.\nQuery MusicBrainz for each letter with a random offset.\nMerge the results into one candidate pool.\nRandomly sample 10–20 artists.\nSave only those artists into the landing layer.",
      "autoResize": true,
      "lineHeight": 1.25
    },
